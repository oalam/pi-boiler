# Configuration du logger chaudière → Powerview2 — à copier en /etc/boiler-logger.conf
# (ce fichier .sample est versionné ; la vraie conf reste hors git.)

# Dossier de dépôt SFTP : <home du compte SFTPGo>/<campagne>/<device>/
# Les composants campagne et device nomment la campagne et l'appareil dans Powerview2.
SFTP_URL="sftp://217.160.116.85/chaudiere/pi-boiler/"

# Identifiants SFTP au format netrc (fichier en 0600, propriétaire pi) :
#   machine 217.160.116.85 login <utilisateur> password <mot de passe>
NETRC_FILE=/etc/boiler-logger.netrc

# Spool local (CSV en attente, outbox, cumuls) — créé par le service.
SPOOL_DIR=/var/lib/boiler-logger

# Préfixe des voies et catégorie des annotations dans Powerview2.
CHANNEL_PREFIX=boiler
EVENT_CATEGORY=chaudiere

# Modèle énergétique (notice MONEX, CEDRA ECO 24).
# Débit de la vis trémie en marche : à calibrer (Amorcer 50 s, peser, diviser par 50).
FEED_RATE_G_PER_S=8.7
# Pouvoir calorifique des granulés (kWh/kg) et rendement de la chaudière.
PCI_KWH_PER_KG=5.0
EFFICIENCY=0.85

# Consigne de la régulation (°C), pour les événements consigne atteinte / reprise.
CONSIGNE_C=75

# Cadence de dépôt (s) et période d'échantillonnage (s).
PUSH_INTERVAL_S=300
SAMPLE_PERIOD_S=1

# Lectures de sonde consécutives en échec avant l'événement « sonde muette ».
SENSOR_FAILURE_THRESHOLD=5
